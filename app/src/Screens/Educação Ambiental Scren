function Quiz() {
  const perguntas = [
    {
      q: "🧃 Qual é o tempo médio de decomposição do plástico?",
      a: ["1 ano", "50 anos", "Mais de 400 anos"],
      correta: 2,
    },
    {
      q: "♻️ Qual destes materiais é reciclável?",
      a: ["Papel", "Pilhas usadas", "Restos de comida"],
      correta: 0,
    },
    {
      q: "🌎 O que significa o símbolo ♻️?",
      a: ["Reutilizar", "Reciclar", "Reduzir"],
      correta: 1,
    },
    {
      q: "🚯 Onde descartar óleo de cozinha usado?",
      a: ["Na pia", "No lixo comum", "Em pontos de coleta específicos"],
      correta: 2,
    },
  ];

  const [index, setIndex] = useState(0);
  const [pontos, setPontos] = useState(0);
  const [anim] = useState(new Animated.Value(0));

  const responder = (i) => {
    const acerto = i === perguntas[index].correta;
    if (acerto) setPontos(pontos + 1);

    // animação de resposta
    Animated.sequence([
      Animated.timing(anim, { toValue: 1, duration: 300, useNativeDriver: true }),
      Animated.timing(anim, { toValue: 0, duration: 300, useNativeDriver: true }),
    ]).start();

    if (index < perguntas.length - 1) {
      setTimeout(() => setIndex(index + 1), 400);
    } else {
      setTimeout(() => {
        alert(`🎉 Você acertou ${pontos + (acerto ? 1 : 0)} de ${perguntas.length}!`);
        setIndex(0);
        setPontos(0);
      }, 400);
    }
  };

  return (
    <Animated.View
      style={[
        styles.quiz,
        {
          transform: [
            {
              scale: anim.interpolate({
                inputRange: [0, 1],
                outputRange: [1, 1.05],
              }),
            },
          ],
        },
      ]}
    >
      <Text style={styles.quizText}>{perguntas[index].q}</Text>
      {perguntas[index].a.map((resp, i) => (
        <TouchableOpacity key={i} style={styles.option} onPress={() => responder(i)}>
          <Text style={styles.optionText}>{resp}</Text>
        </TouchableOpacity>
      ))}
      <Text style={styles.progress}>
        Pergunta {index + 1} de {perguntas.length}
      </Text>
    </Animated.View>
  );
}

